# Neon Database (trusted-leads-service)
TRUSTED_LEADS_SERVICE_DATABASE_URL='postgresql://...'

# Sentry (error tracking)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Key Service (resolves the platform "apify" key)
KEY_SERVICE_URL='http://key-service.railway.internal'
KEY_SERVICE_API_KEY='your-key-service-api-key'

# Runs Service (cost tracking)
RUNS_SERVICE_URL='https://runs.mcpfactory.org'
RUNS_SERVICE_API_KEY='your-runs-service-api-key'

# Billing Service (affordability authorize for platform-key spend)
BILLING_SERVICE_URL='http://billing-service.railway.internal'
BILLING_SERVICE_API_KEY='your-billing-service-api-key'

# Server
PORT=3010
